# Normalize line endings for cross-platform collaboration
* text=auto

# Explicitly treat source files as text
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.ipynb text eol=lf

# Binary / model artifacts (never auto-convert)
*.bin binary
*.pt binary
*.pth binary
*.safetensors binary
*.gguf binary
*.zip binary
*.gz binary